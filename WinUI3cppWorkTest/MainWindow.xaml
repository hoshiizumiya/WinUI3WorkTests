        <TextBlock
            x:Name="IP"
            Height="50"
            PointerEntered="TextBlock_PointerEntered" />
        <ContentPresenter x:Name="ContentPresenter" Grid.Row="1" />
        <Button
            x:Name="Button1"
            Grid.Row="2"
            Click="Button_Click"
            Content="ContentDialog Window" />
        <Button
            x:Name="Button2"
            Grid.Row="3"
            Click="Button2_Click">
            Self defined modal window
        </Button>
        <Grid
            x:Name="RootGrid"
            Grid.Row="4"
            Padding="24"
            RowSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="Backdrop:" />
                <ComboBox
                    x:Name="BackdropCombo"
                    Width="220"
                    SelectionChanged="BackdropCombo_SelectionChanged">

                    <ComboBoxItem
                        Content="None"
                        IsSelected="True"
                        Tag="None" />
                    <ComboBoxItem Content="Mica (Base)" Tag="MicaBase" />
                    <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    <ComboBoxItem Content="Acrylic (Base)" Tag="AcrylicBase" />
                    <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                </ComboBox>
                <Button>
                    <Flyout>
                        <MenuFlyoutItem Click="MenuFlyoutItem_Click" />
                    </Flyout>
                </Button>
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,16,0,0"
                Text="Use the ComboBox to switch Window backdrop among Mica/Mica Alt/Acrylic Base/Acrylic Thin."
                TextWrapping="Wrap" />
        </Grid>
        <StackPanel
            Grid.Row="5"
            Padding="20"
            Spacing="10">
            <!--<Button Content="添加任务" Command="{x:Bind ViewModel.AddTaskCommand}" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" />-->
            <TextBlock>ssss</TextBlock>
        </StackPanel>



    </Grid>
