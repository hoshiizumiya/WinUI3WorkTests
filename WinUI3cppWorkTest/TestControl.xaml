<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUI3cppWorkTest.TestControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3cppWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg="using:WinUI3Package.Svg"
    mc:Ignorable="d">

    <StackPanel>
        <Border
            Padding="8,4,0,4"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            CornerRadius="4">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <ToggleMenuFlyoutItem
                        x:Name="CTest"
                        IsChecked="True"
                        Text="Test" />
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
        <Grid>
            <Image
                x:Name="ImageTest"
                Width="500"
                Height="500"
                VerticalAlignment="Center"
                x:Load="{x:Bind CTest.IsChecked, Mode=OneWay}">
                <Image.Source>
                    <BitmapImage DecodePixelHeight="{x:Bind essential:Convert.DoubleToInt32(ImageTest.Height), Mode=OneWay}" UriSource="/Assets/StoreLogo.png" />
                </Image.Source>
            </Image>
        </Grid>
    </StackPanel>
</UserControl>
