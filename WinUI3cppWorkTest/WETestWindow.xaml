<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3cppWorkTest.WETestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:essential="using:WinUI3Package"
    Title="WinUI Essentials layout timing tests"
    MinWidth="900"
    MinHeight="620">

    <Grid x:Name="TestRoot" Padding="16" RowSpacing="10">
        <Grid.Resources>
            <!-- Mirrors OpenNet's task row: full-row progress layer, task identity,
                 several measured columns, and a progress-cell overlay. -->
            <DataTemplate x:Key="ProgressSample">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <essential:ProgressBarEx
                        Margin="0,2"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BaseColor="Transparent"
                        HighColor="LimeGreen"
                        IsHitTestVisible="False"
                        Opacity="0.65"
                        Percent="38" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="HTTP download" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <Grid Grid.Column="4" MinWidth="130" VerticalAlignment="Center">
                            <essential:ProgressBarEx
                                Height="24"
                                Background="Transparent"
                                BaseColor="Transparent"
                                HighColor="LimeGreen"
                                IsHitTestVisible="False"
                                Percent="38" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="38%" />
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="CardSample">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:SettingsCard Grid.Column="4" Header="{Binding}" Description="Realized task row" />
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ExpanderSample">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:SettingsExpander Grid.Column="4" Header="{Binding}" Description="Realized task row" />
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="GroupSample">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:GroupBox Grid.Column="4" Header="Group"><TextBlock Text="{Binding}" /></essential:GroupBox>
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock FontSize="22" Text="Essential control first-use timing" />
            <TextBlock Text="Restart between tests. The task list is populated and x:Bind-connected before layout. Cold reveals it before the selected control has loaded resources; warm loads the control before XAML measures and realizes visible rows." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ControlChoice" Width="170" SelectedIndex="0">
                    <ComboBoxItem Content="ProgressBarEx" />
                    <ComboBoxItem Content="SettingsCard" />
                    <ComboBoxItem Content="SettingsExpander" />
                    <ComboBoxItem Content="GroupBox" />
                </ComboBox>
                <Button x:Name="ColdListButton" Click="RunColdList_Click" Content="Cold virtualized list" />
                <Button x:Name="WarmListButton" Click="RunWarmList_Click" Content="Prewarm, then list" />
                <Button x:Name="DirectButton" Click="RunDirect_Click" Content="Direct creation" />
            </StackPanel>
        </StackPanel>

        <!-- OpenNet places a task list above a details area beside a filter pane. -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Downloading" />
                    <TextBlock Text="Seeding" />
                    <TextBlock Text="Completed" />
                    <TextBlock Text="Active" />
                    <TextBlock Text="Inactive" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="SamplesList"
                    Grid.Row="0"
                    ItemsSource="{x:Bind TaskItems, Mode=OneWay}"
                    Visibility="Collapsed"
                    MaxHeight="360"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled">
                    <ListView.Header>
                        <Border Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Name / source" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Size" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Downloaded" />
                                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Progress" />
                            </Grid>
                        </Border>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" Text="Selected task details" />
                        <TextBlock Text="This lower panel keeps the list in the same list-plus-details arrangement as OpenNet." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <ContentControl x:Name="DirectHost" />
            <TextBlock x:Name="Diagnostics" Text="Choose one scenario after each launch." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</essential:WindowEx>
