<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3cppWorkTest.WETestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3cppWorkTest"
    Title="WinUI Essentials layout timing tests"
    MinWidth="900"
    MinHeight="620">

    <Grid x:Name="TestRoot" Padding="16" RowSpacing="10">
        <Grid.Resources>
            <!-- Mirrors OpenNet's task row: full-row progress layer, task identity,
                 several measured columns, and a progress-cell overlay. -->
            <DataTemplate x:Key="ProgressSample" x:DataType="local:TaskSampleViewModel">
                <Grid HorizontalAlignment="Left" Loaded="SampleItem_Loaded">
                    <essential:ProgressBarEx
                        Loaded="ProgressControl_Loaded"
                        Margin="0,2"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BaseColor="{x:Bind ProgressBaseColor, Mode=OneWay}"
                        HighColor="{x:Bind ProgressHighColor, Mode=OneWay}"
                        IsHitTestVisible="False"
                        Opacity="0.65"
                        Percent="{x:Bind ProgressPercent, Mode=OneWay}"
                        Visibility="{x:Bind ProgressRowEffectVisibility, Mode=OneWay}" />
                    <local:TaskDataRow VerticalAlignment="Stretch" Loaded="TaskDataRow_Loaded">
                        <Grid VerticalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="HTTP download" />
                            </StackPanel>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="1.2 GiB" />
                        <Grid MinWidth="110" VerticalAlignment="Center">
                            <essential:ProgressBarEx
                                Loaded="ProgressControl_Loaded"
                                Height="20"
                                Background="Transparent"
                                BaseColor="{x:Bind ProgressBaseColor, Mode=OneWay}"
                                HighColor="{x:Bind ProgressHighColor, Mode=OneWay}"
                                IsHitTestVisible="False"
                                Percent="{x:Bind ProgressPercent, Mode=OneWay}"
                                Visibility="{x:Bind ProgressColumnEffectVisibility, Mode=OneWay}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="38%" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="456 MiB" />
                        <TextBlock VerticalAlignment="Center" Text="0 B" />
                        <TextBlock VerticalAlignment="Center" Text="456 MiB" />
                        <TextBlock VerticalAlignment="Center" Text="0 B" />
                        <TextBlock VerticalAlignment="Center" Text="4.2 MiB/s" />
                        <TextBlock VerticalAlignment="Center" Text="0 B/s" />
                        <TextBlock VerticalAlignment="Center" Text="00:02:14" />
                        <TextBlock VerticalAlignment="Center" Text="Today" />
                        <TextBlock VerticalAlignment="Center" Text="—" />
                        <TextBlock VerticalAlignment="Center" Text="0.00" />
                        <TextBlock VerticalAlignment="Center" Text="0 / 3" />
                    </local:TaskDataRow>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="CardSample" x:DataType="local:TaskSampleViewModel">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name, Mode=OneTime}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:SettingsCard Grid.Column="4" Header="{x:Bind Name, Mode=OneTime}" Description="Realized task row" />
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ExpanderSample" x:DataType="local:TaskSampleViewModel">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name, Mode=OneTime}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:SettingsExpander Grid.Column="4" Header="{x:Bind Name, Mode=OneTime}" Description="Realized task row" />
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="GroupSample" x:DataType="local:TaskSampleViewModel">
                <Grid Height="56" Loaded="SampleItem_Loaded">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name, Mode=OneTime}" /><TextBlock FontSize="11" Text="HTTP download" /></StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="1.2 GiB" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="456 MiB" />
                        <essential:GroupBox Grid.Column="4" Header="Group"><TextBlock Text="{x:Bind Name, Mode=OneTime}" /></essential:GroupBox>
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock FontSize="22" Text="Essential control first-use timing" />
            <TextBlock Text="Restart between tests. The visible ProgressBarEx task list and its XAML ItemTemplate are created before layout, bound to an empty collection, then populated. Cold lets the first row instantiate ProgressBarEx during list realization; warm loads its resources before adding tasks. The other controls can be tested with Direct creation." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Direct control:" />
                <ComboBox x:Name="ControlChoice" Width="170" SelectedIndex="0">
                    <ComboBoxItem Content="ProgressBarEx" />
                    <ComboBoxItem Content="SettingsCard" />
                    <ComboBoxItem Content="SettingsExpander" />
                    <ComboBoxItem Content="GroupBox" />
                </ComboBox>
                <Button x:Name="ColdListButton" Click="RunColdList_Click" Content="Cold ProgressBarEx list" />
                <Button x:Name="WarmListButton" Click="RunWarmList_Click" Content="Prewarm ProgressBarEx, then list" />
                <Button x:Name="DirectButton" Click="RunDirect_Click" Content="Direct creation" />
            </StackPanel>
        </StackPanel>

        <!-- OpenNet places a task list above a details area beside a filter pane. -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Downloading" />
                    <TextBlock Text="Seeding" />
                    <TextBlock Text="Completed" />
                    <TextBlock Text="Active" />
                    <TextBlock Text="Inactive" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="SamplesList"
                    Grid.Row="0"
                    ItemTemplate="{StaticResource ProgressSample}"
                    ItemsSource="{x:Bind TaskItems, Mode=OneWay}"
                    MaxHeight="360"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    SelectionMode="Single">
                    <ListView.Header>
                        <Border Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                            <Grid Width="1948" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Name / source" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Size" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Progress" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Downloaded" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Uploaded" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Total DL" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Total UL" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="DL rate" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="UL rate" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="Remaining" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="10" FontWeight="SemiBold" Text="Added" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="11" FontWeight="SemiBold" Text="Completed" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="12" FontWeight="SemiBold" Text="Ratio" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="13" FontWeight="SemiBold" Text="Peers" TextTrimming="CharacterEllipsis" />

                            </Grid>
                        </Border>
                    </ListView.Header>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" Text="Selected task details" />
                        <TextBlock Text="This lower panel keeps the list in the same list-plus-details arrangement as OpenNet." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <ContentControl x:Name="DirectHost" />
            <TextBlock x:Name="Diagnostics" Text="Choose one scenario after each launch." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</essential:WindowEx>
