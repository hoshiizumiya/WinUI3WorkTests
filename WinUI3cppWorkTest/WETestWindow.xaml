<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3cppWorkTest.WETestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3cppWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WETestWindow"
    MinWidth="480"
    MinHeight="360"
    IsAlwaysOnTop="True"
    mc:Ignorable="d">

    <essential:WindowEx.SystemBackdrop>
        <essential:MicaBackdropWithFallback>
            <essential:MicaBackdropWithFallback.Fallback>
                <DesktopAcrylicBackdrop />
            </essential:MicaBackdropWithFallback.Fallback>
        </essential:MicaBackdropWithFallback>
    </essential:WindowEx.SystemBackdrop>

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind Window}" />

        <TitleBar
            Title="Dev Window"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Subtitle="Developer test entry points" />

        <ScrollView Grid.Row="1" Loaded="ScrollView_Loaded">
            <StackPanel Margin="16" Spacing="10">
                <ListView x:Name="BaseExample" BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Contact">
                            <Grid HorizontalAlignment="Left">
                                <essential:ProgressBarEx />
                                <TextBlock
                                    Margin="0,5,0,5"
                                    x:Phase="1"
                                    Text="{x:Bind Name}" />

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </StackPanel>
        </ScrollView>
    </Grid>
</essential:WindowEx>
