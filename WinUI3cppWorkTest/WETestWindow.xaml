<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3cppWorkTest.WETestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3cppWorkTest"
    Title="OpenNet task list layout reproduction"
    MinWidth="900"
    MinHeight="620">

    <Grid Loaded="Window_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            Margin="4,2,4,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4"
            DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Add task" />
            <AppBarButton Icon="Play" Label="Start" />
            <AppBarButton Icon="Pause" Label="Pause" />
            <AppBarButton Icon="Delete" Label="Delete" />
        </CommandBar>
        <AutoSuggestBox
            Grid.Row="0"
            Width="280"
            Margin="12,6"
            HorizontalAlignment="Left"
            PlaceholderText="Search"
            QueryIcon="Find" />

        <Grid Grid.Row="1" Margin="4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <NavigationView
                    Background="Transparent"
                    CompactPaneLength="50"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    PaneDisplayMode="LeftCompact">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="All" Icon="List" IsSelected="True" />
                        <NavigationViewItem Content="Downloading" Icon="Download" />
                        <NavigationViewItem Content="Seeding" Icon="Upload" />
                        <NavigationViewItem Content="Completed" Icon="Accept" />
                        <NavigationViewItem Content="Active" Icon="Play" />
                        <NavigationViewItem Content="Inactive" Icon="Pause" />
                    </NavigationView.MenuItems>
                </NavigationView>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TasksListRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListView
                    x:Name="TasksList"
                    Grid.Row="0"
                    ItemsSource="{x:Bind ViewModel.FilteredTasks, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Border
                            Padding="8,4,0,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                            <Grid Width="2048" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColName" Grid.Column="0" FontWeight="SemiBold" Text="Name / source" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColSize" Grid.Column="1" FontWeight="SemiBold" Text="Size" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColProgress" Grid.Column="2" FontWeight="SemiBold" Text="Progress" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColDownloadSize" Grid.Column="3" FontWeight="SemiBold" Text="Downloaded" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColUploadSize" Grid.Column="4" FontWeight="SemiBold" Text="Uploaded" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColumnTotalDownloadSize" Grid.Column="5" FontWeight="SemiBold" Text="Total DL" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColumnTotalUploadSize" Grid.Column="6" FontWeight="SemiBold" Text="Total UL" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColDLRate" Grid.Column="7" FontWeight="SemiBold" Text="DL rate" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColULRate" Grid.Column="8" FontWeight="SemiBold" Text="UL rate" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColRemaining" Grid.Column="9" FontWeight="SemiBold" Text="Remaining" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColAddDate" Grid.Column="10" FontWeight="SemiBold" Text="Added" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColCompletedDate" Grid.Column="11" FontWeight="SemiBold" Text="Completed" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColShareRatio" Grid.Column="12" FontWeight="SemiBold" Text="Ratio" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ColSeeds" Grid.Column="13" FontWeight="SemiBold" Text="Peers" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </ListView.Header>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TaskSampleViewModel">
                            <Grid HorizontalAlignment="Left">
                                <essential:ProgressBarEx
                                    Margin="0,2,0,2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BaseColor="{x:Bind ProgressBaseColor, Mode=OneWay}"
                                    CornerRadius="8"
                                    HighColor="{x:Bind ProgressHighColor, Mode=OneWay}"
                                    IsHitTestVisible="False"
                                    Opacity="0.65"
                                    Percent="{x:Bind ProgressPercent, Mode=OneWay}"
                                    Visibility="{x:Bind ProgressRowEffectVisibility, Mode=OneWay}" />
                                <local:TaskDataRow HorizontalAlignment="Left" Loaded="TaskDataRow_Loaded">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="12" Height="12" Fill="LimeGreen" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Left" Spacing="0">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Transport, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind Size, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColSize.Visibility, Mode=OneWay}" />
                                    <Grid MinWidth="110" Visibility="{x:Bind ColProgress.Visibility, Mode=OneWay}">
                                        <essential:ProgressBarEx
                                            Height="20"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            BaseColor="{x:Bind ProgressBaseColor, Mode=OneWay}"
                                            CornerRadius="6"
                                            HighColor="{x:Bind ProgressHighColor, Mode=OneWay}"
                                            IsHitTestVisible="False"
                                            Percent="{x:Bind ProgressPercent, Mode=OneWay}"
                                            Visibility="{x:Bind ProgressColumnEffectVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="4,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Canvas.ZIndex="1"
                                            Text="{x:Bind Progress, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind DownloadSize, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColDownloadSize.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind UploadSize, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColUploadSize.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind TotalDownloadSize, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColumnTotalDownloadSize.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind TotalUploadSize, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColumnTotalUploadSize.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind DownloadRate, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColDLRate.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind UploadRate, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColULRate.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind Remaining, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColRemaining.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind AddDate, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColAddDate.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind CompletedDate, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColCompletedDate.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind ShareRatio, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColShareRatio.Visibility, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind Seeds, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind ColSeeds.Visibility, Mode=OneWay}" />
                                </local:TaskDataRow>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" Text="Selected task details" />
                        <TextBlock Text="The task list is populated from the view model when the window loads." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</essential:WindowEx>
