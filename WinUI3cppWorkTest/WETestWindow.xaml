<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3cppWorkTest.WETestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:essential="using:WinUI3Package"
    Title="ProgressBarEx first-use layout repro"
    MinWidth="640"
    MinHeight="420">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock FontSize="20" Text="ProgressBarEx first-use layout repro" />
            <TextBlock Text="Restart the app before each test. The list starts empty and completes its initial layout before you choose a case." TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ColdListButton" Click="ColdListButton_Click" Content="Cold ProgressBarEx in ListView" />
            <Button x:Name="PrewarmButton" Click="PrewarmButton_Click" Content="Prewarm, then populate ListView" />
            <Button x:Name="DirectButton" Click="DirectButton_Click" Content="Direct construction" />
        </StackPanel>

        <ListView
            x:Name="TasksList"
            Grid.Row="2"
            ItemsSource="{x:Bind TaskItems, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Value is normalized to 0..1; 0.5 displays 50%. -->
                    <essential:ProgressBarEx Height="20" Percent="50" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8">
            <ContentControl x:Name="DirectHost" />
            <TextBlock x:Name="Status" Text="No test has run." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</essential:WindowEx>
