<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3csWorkTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUI3csWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Composition backdrop invalidation repro"
    mc:Ignorable="d">

    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0" Height="36">
            <TextBlock FontSize="14" Text="Composition backdrop invalidation repro" />
        </TitleBar>

        <Grid
            Grid.Row="1"
            Padding="12,8"
            Background="#EE202020"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Compare backdrop invalidation when the source moves vs. when the effect visual moves." />
                <TextBlock
                    x:Name="WallpaperStatusText"
                    FontSize="12"
                    Opacity="0.72"
                    Text="Loading the current system wallpaper..." />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Scenario" />
                <ComboBox x:Name="ScenarioSelector" SelectedIndex="0">
                    <ComboBoxItem Content="Move backdrop content" />
                    <ComboBoxItem Content="Move effect visuals" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Native effect under test" />
                <ComboBox x:Name="EffectSelector" SelectedIndex="0">
                    <ComboBoxItem Content="GaussianBlurEffect" />
                    <ComboBoxItem Content="SaturationEffect" />
                    <ComboBoxItem Content="HueRotationEffect" />
                    <ComboBoxItem Content="InvertEffect" />
                    <ComboBoxItem Content="SepiaEffect" />
                    <ComboBoxItem Content="ExposureEffect" />
                    <ComboBoxItem Content="GrayscaleEffect" />
                </ComboBox>
            </StackPanel>

            <ToggleSwitch
                x:Name="AutoMotionToggle"
                Grid.Column="3"
                VerticalAlignment="Center"
                Header="Auto motion"
                IsOn="False"
                Toggled="AutoMotionToggle_Toggled" />

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Motion speed" />
                <Slider
                    x:Name="MotionSpeedSlider"
                    Maximum="64"
                    Minimum="4"
                    StepFrequency="4"
                    Value="24" />
            </StackPanel>

            <Button
                Grid.Column="5"
                VerticalAlignment="Center"
                Click="ResetMotion_Click"
                Content="Reset" />
        </Grid>

        <Grid Grid.Row="2">
            <!-- Scenario 1: the backdrop content moves while effect visuals remain fixed. -->
            <Grid x:Name="ScrollingBackdropTestRoot">
                <ScrollViewer
                    x:Name="BackdropSourceScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible">
                    <StackPanel
                        x:Name="BackdropSourcePanel"
                        Padding="24"
                        Spacing="18" />
                </ScrollViewer>

                <Grid
                    Width="1020"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="RawBackdropCard"
                        Grid.Column="0"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="Raw CompositionBackdropBrush"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>

                    <Border
                        x:Name="AcrylicCard"
                        Grid.Column="1"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="WinUI AcrylicBrush"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>

                    <Border
                        x:Name="SelectedEffectCard"
                        Grid.Column="2"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            x:Name="SelectedEffectLabel"
                            Title="GaussianBlurEffect"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Scenario 2: the backdrop is static and the effect-bearing XAML visuals move. -->
            <Grid
                x:Name="MovingEffectTestRoot"
                Visibility="Collapsed">
                <Border x:Name="StaticWallpaperBackground" />

                <Grid IsHitTestVisible="False">
                    <Border
                        Width="90"
                        Margin="90,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CCFFFFFF" />
                    <Border
                        Width="90"
                        Margin="290,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CC101010" />
                    <Border
                        Width="90"
                        Margin="490,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CCFFFFFF" />
                    <Border
                        Width="90"
                        Margin="690,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CC101010" />

                    <TextBlock
                        Margin="40,36,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Consolas"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="STATIC BACKDROP  A  B  C  D" />
                    <TextBlock
                        Margin="40,0,0,38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontFamily="Consolas"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="Black"
                        Text="0123456789  /  STATIC XAML MARKERS  /  9876543210" />
                </Grid>

                <Grid
                    x:Name="MovingEffectHost"
                    Width="320"
                    Height="540"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="MovingRawBackdropCard"
                        Grid.Row="0"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="Raw CompositionBackdropBrush"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>

                    <Border
                        x:Name="MovingAcrylicCard"
                        Grid.Row="1"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="WinUI AcrylicBrush"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>

                    <Border
                        x:Name="MovingSelectedEffectCard"
                        Grid.Row="2"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            x:Name="MovingSelectedEffectLabel"
                            Title="GaussianBlurEffect"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
