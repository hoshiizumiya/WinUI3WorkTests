<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3csWorkTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUI3csWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Composition backdrop invalidation repro"
    mc:Ignorable="d">

    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0" Height="36">
            <TextBlock FontSize="14" Text="Composition backdrop invalidation repro" />
        </TitleBar>

        <Grid
            Grid.Row="1"
            Padding="12,8"
            Background="#EE202020"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Scroll the wallpaper-backed XAML content under the fixed effect cards." />
                <TextBlock
                    x:Name="WallpaperStatusText"
                    FontSize="12"
                    Opacity="0.72"
                    Text="Loading the current system wallpaper..." />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Native effect under test" />
                <ComboBox
                    x:Name="EffectSelector"
                    SelectedIndex="0">
                    <ComboBoxItem Content="GaussianBlurEffect" />
                    <ComboBoxItem Content="SaturationEffect" />
                    <ComboBoxItem Content="HueRotationEffect" />
                    <ComboBoxItem Content="InvertEffect" />
                    <ComboBoxItem Content="SepiaEffect" />
                    <ComboBoxItem Content="ExposureEffect" />
                    <ComboBoxItem Content="GrayscaleEffect" />
                </ComboBox>
            </StackPanel>

            <ToggleSwitch
                x:Name="AutoScrollToggle"
                Grid.Column="2"
                VerticalAlignment="Center"
                Header="Auto scroll"
                IsOn="False"
                Toggled="AutoScrollToggle_Toggled" />

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock FontSize="12" Text="Scroll speed (DIP/tick)" />
                <Slider
                    x:Name="ScrollSpeedSlider"
                    Maximum="64"
                    Minimum="4"
                    StepFrequency="4"
                    Value="24" />
            </StackPanel>

            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Click="ResetScroll_Click"
                Content="Reset" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="BackdropSourceScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Visible">
                <StackPanel
                    x:Name="BackdropSourcePanel"
                    Padding="24"
                    Spacing="18" />
            </ScrollViewer>

            <Grid
                Width="1020"
                Height="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="RawBackdropCard"
                    Grid.Column="0"
                    Margin="8"
                    BorderBrush="#E8FFFFFF"
                    BorderThickness="1">
                    <local:EffectCardLabel
                        Title="Raw CompositionBackdropBrush"
                        Subtitle="No effect factory" />
                </Border>

                <Border
                    x:Name="AcrylicCard"
                    Grid.Column="1"
                    Margin="8"
                    BorderBrush="#E8FFFFFF"
                    BorderThickness="1">
                    <local:EffectCardLabel
                        Title="WinUI AcrylicBrush"
                        Subtitle="Built-in baseline" />
                </Border>

                <Border
                    x:Name="SelectedEffectCard"
                    Grid.Column="2"
                    Margin="8"
                    BorderBrush="#E8FFFFFF"
                    BorderThickness="1">
                    <local:EffectCardLabel
                        x:Name="SelectedEffectLabel"
                        Title="GaussianBlurEffect"
                        Subtitle="BlurAmount = 28" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
