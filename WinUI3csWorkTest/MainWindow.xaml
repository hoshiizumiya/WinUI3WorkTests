<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3csWorkTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUI3csWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Composition backdrop invalidation repro"
    mc:Ignorable="d">

    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="Composition backdrop invalidation repro"
            IsPaneToggleButtonVisible="True">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">44</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">44</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,6,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="TitleBarInvertThemeButton"
                        Padding="6"
                        Content="[Dev] Invert Theme" />
                    <Button
                        x:Name="TitleBarBackgroundTaskButton"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <Button.Content>
                            <Border Padding="16,6">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Background task" />
                                    <FontIcon
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Glyph="&#xE70D;" />
                                </Grid>
                            </Border>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="280" Spacing="8">
                                    <ProgressBar IsIndeterminate="True" />
                                    <TextBlock Text="Metadata initialization" />
                                    <TextBlock Text="Full trust initialization" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid
            Grid.Row="1"
            Padding="12,8"
            Background="#EE202020"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Compare backdrop invalidation when the source moves vs. when the effect visual moves." />
                <TextBlock
                    x:Name="WallpaperStatusText"
                    FontSize="12"
                    Opacity="0.72"
                    Text="Loading the current system wallpaper..." />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Scenario" />
                <ComboBox x:Name="ScenarioSelector" SelectedIndex="0">
                    <ComboBoxItem Content="Move backdrop content" />
                    <ComboBoxItem Content="Move effect visuals" />
                    <ComboBoxItem Content="Move effects over real controls" />
                    <ComboBoxItem Content="Effect child inside ScrollViewer" />
                    <ComboBoxItem Content="Hutao hierarchy / shared LiquidGlass" />
                    <ComboBoxItem Content="Real TitleBar + single scrolled LiquidGlass" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Native effect under test" />
                <ComboBox x:Name="EffectSelector" SelectedIndex="0">
                    <ComboBoxItem Content="GaussianBlurEffect" />
                    <ComboBoxItem Content="SaturationEffect" />
                    <ComboBoxItem Content="HueRotationEffect" />
                    <ComboBoxItem Content="InvertEffect" />
                    <ComboBoxItem Content="SepiaEffect" />
                    <ComboBoxItem Content="ExposureEffect" />
                    <ComboBoxItem Content="GrayscaleEffect" />
                </ComboBox>
            </StackPanel>

            <ToggleSwitch
                x:Name="AutoMotionToggle"
                Grid.Column="3"
                VerticalAlignment="Center"
                Header="Auto motion"
                IsOn="False"
                Toggled="AutoMotionToggle_Toggled" />

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="Motion speed" />
                <Slider
                    x:Name="MotionSpeedSlider"
                    Maximum="64"
                    Minimum="4"
                    StepFrequency="4"
                    Value="24" />
            </StackPanel>

            <Button
                Grid.Column="5"
                VerticalAlignment="Center"
                Click="ResetMotion_Click"
                Content="Reset" />
        </Grid>

        <Grid Grid.Row="2">
            <!-- Scenario 1: the backdrop content moves while effect visuals remain fixed. -->
            <Grid x:Name="ScrollingBackdropTestRoot">
                <ScrollViewer
                    x:Name="BackdropSourceScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible">
                    <StackPanel
                        x:Name="BackdropSourcePanel"
                        Padding="24"
                        Spacing="18" />
                </ScrollViewer>

                <Grid
                    Width="1020"
                    Height="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="RawBackdropCard"
                        Grid.Column="0"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="Raw CompositionBackdropBrush"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>

                    <Border
                        x:Name="AcrylicCard"
                        Grid.Column="1"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="WinUI AcrylicBrush"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>

                    <Border
                        x:Name="SelectedEffectCard"
                        Grid.Column="2"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            x:Name="SelectedEffectLabel"
                            Title="GaussianBlurEffect"
                            Subtitle="Fixed visual; moving backdrop" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Scenario 2: the backdrop is static and the effect-bearing XAML visuals move. -->
            <Grid
                x:Name="MovingEffectTestRoot"
                Visibility="Collapsed">
                <Border x:Name="StaticWallpaperBackground" />

                <Grid IsHitTestVisible="False">
                    <Border
                        Width="90"
                        Margin="90,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CCFFFFFF" />
                    <Border
                        Width="90"
                        Margin="290,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CC101010" />
                    <Border
                        Width="90"
                        Margin="490,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CCFFFFFF" />
                    <Border
                        Width="90"
                        Margin="690,0,0,0"
                        HorizontalAlignment="Left"
                        Background="#CC101010" />

                    <TextBlock
                        Margin="40,36,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Consolas"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="STATIC BACKDROP  A  B  C  D" />
                    <TextBlock
                        Margin="40,0,0,38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        FontFamily="Consolas"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="Black"
                        Text="0123456789  /  STATIC XAML MARKERS  /  9876543210" />
                </Grid>

                <Grid
                    x:Name="MovingEffectHost"
                    Width="320"
                    Height="540"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="MovingRawBackdropCard"
                        Grid.Row="0"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="Raw CompositionBackdropBrush"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>

                    <Border
                        x:Name="MovingAcrylicCard"
                        Grid.Row="1"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="WinUI AcrylicBrush"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>

                    <Border
                        x:Name="MovingSelectedEffectCard"
                        Grid.Row="2"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            x:Name="MovingSelectedEffectLabel"
                            Title="GaussianBlurEffect"
                            Subtitle="Moving visual; static backdrop" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Scenario 3: move the effect-bearing visuals over real XAML controls. -->
            <Grid
                x:Name="MovingEffectOverControlsTestRoot"
                Visibility="Collapsed">
                <Border x:Name="LiveControlsWallpaperBackground" />

                <Grid Padding="28" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="General" />
                        <Button Content="Open settings" />
                        <ToggleSwitch Header="Enable feature" IsOn="True" />
                        <CheckBox Content="Keep history" IsChecked="True" />
                        <RadioButton Content="Recommended mode" IsChecked="True" />
                        <Slider Header="Opacity" Minimum="0" Maximum="100" Value="62" />
                        <ProgressBar Height="8" Maximum="100" Value="72" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Network" />
                        <TextBox Header="Server" Text="example.contoso.test" />
                        <PasswordBox Header="Token" Password="backdrop-sample" />
                        <ComboBox Header="Transport" SelectedIndex="1">
                            <ComboBoxItem Content="TCP" />
                            <ComboBoxItem Content="QUIC" />
                            <ComboBoxItem Content="WebSocket" />
                        </ComboBox>
                        <Button Content="Test connection" />
                        <ToggleSwitch Header="Use system proxy" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Downloads" />
                        <Button Content="Add download" />
                        <Button Content="Pause all" />
                        <CheckBox Content="Seed after completion" IsChecked="True" />
                        <Slider Header="Speed limit" Minimum="0" Maximum="100" Value="83" />
                        <ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            IsActive="True" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Message="Real WinUI controls behind the moving backdrop." />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Appearance" />
                        <ToggleButton Content="Toggle button" IsChecked="True" />
                        <DropDownButton Content="Theme">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Light" />
                                    <MenuFlyoutItem Text="Dark" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <CalendarDatePicker Header="Date" />
                        <RatingControl Value="4" />
                        <Button Content="Apply changes" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="LiveControlsEffectHost"
                    Width="320"
                    Height="540"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="LiveControlsRawBackdropCard"
                        Grid.Row="0"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="Raw CompositionBackdropBrush"
                            Subtitle="Moving visual over real controls" />
                    </Border>

                    <Border
                        x:Name="LiveControlsAcrylicCard"
                        Grid.Row="1"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            Title="WinUI AcrylicBrush"
                            Subtitle="Moving visual over real controls" />
                    </Border>

                    <Border
                        x:Name="LiveControlsSelectedEffectCard"
                        Grid.Row="2"
                        Margin="8"
                        BorderBrush="#E8FFFFFF"
                        BorderThickness="1">
                        <local:EffectCardLabel
                            x:Name="LiveControlsSelectedEffectLabel"
                            Title="GaussianBlurEffect"
                            Subtitle="Moving visual over real controls" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Scenario 4: the effect itself is a child of ScrollViewer content.
                 Scrolling moves the effect through ScrollViewer/DManip ancestor transforms. -->
            <Grid
                x:Name="ScrollContainedEffectTestRoot"
                Visibility="Collapsed">
                <Border x:Name="ScrollContainedFixedWallpaperBackground" />

                <!-- Fixed content behind the transparent ScrollViewer. These controls do not move. -->
                <Grid IsHitTestVisible="False">
                    <StackPanel
                        Margin="32,28,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button Content="[Dev] Invert Theme" />
                        <DropDownButton Content="Background task">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Task A" />
                                    <MenuFlyoutItem Text="Task B" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <ToggleSwitch Header="Fixed header control" IsOn="True" />
                    </StackPanel>

                    <StackPanel
                        Margin="32,104,32,0"
                        VerticalAlignment="Top"
                        Spacing="10">
                        <Border Height="46" Background="#D9FFFFFF" />
                        <Border Height="46" Background="#D9202020" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="FIXED BACKDROP MARKER 00 11 22 33 44 55" />
                    </StackPanel>
                </Grid>

                <!-- Important: Background is intentionally ordinary/transparent.
                     The backdrop effect is on a CHILD inside the scrolling content. -->
                <ScrollViewer
                    x:Name="ScrollContainedEffectScroller"
                    Background="Transparent"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible">
                    <StackPanel
                        Padding="24"
                        Spacing="18">

                        <Border Height="240" Background="Transparent">
                            <TextBlock
                                Margin="12"
                                VerticalAlignment="Bottom"
                                FontSize="18"
                                Opacity="0.8"
                                Text="Scroll down. The effect panels below are children of this ScrollViewer content." />
                        </Border>

                        <Grid Height="520">
                            <!-- Real controls that move in the same ScrollViewer subtree. -->
                            <Grid Padding="16" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="12">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Scrolling controls A" />
                                    <Button Content="Button A1" />
                                    <ToggleSwitch Header="Toggle A2" IsOn="True" />
                                    <CheckBox Content="Check A3" IsChecked="True" />
                                    <TextBox Header="Text A4" Text="ScrollViewer child" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Scrolling controls B" />
                                    <Button Content="Button B1" />
                                    <ComboBox Header="Combo B2" SelectedIndex="1">
                                        <ComboBoxItem Content="First" />
                                        <ComboBoxItem Content="Second" />
                                        <ComboBoxItem Content="Third" />
                                    </ComboBox>
                                    <Slider Header="Slider B3" Minimum="0" Maximum="100" Value="68" />
                                    <ProgressBar Height="8" Maximum="100" Value="54" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="12">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Scrolling controls C" />
                                    <Button Content="Button C1" />
                                    <RadioButton Content="Radio C2" IsChecked="True" />
                                    <CalendarDatePicker Header="Date C3" />
                                    <RatingControl Value="4" />
                                </StackPanel>
                            </Grid>

                            <!-- These effect-bearing elements are themselves moved by the ScrollViewer. -->
                            <Grid
                                Margin="40,220,40,18"
                                IsHitTestVisible="False"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="ScrollContainedRawBackdropCard"
                                    Grid.Column="0"
                                    BorderBrush="#E8FFFFFF"
                                    BorderThickness="1">
                                    <local:EffectCardLabel
                                        Title="Raw CompositionBackdropBrush"
                                        Subtitle="Child of ScrollViewer content" />
                                </Border>

                                <Border
                                    x:Name="ScrollContainedAcrylicCard"
                                    Grid.Column="1"
                                    BorderBrush="#E8FFFFFF"
                                    BorderThickness="1">
                                    <local:EffectCardLabel
                                        Title="WinUI AcrylicBrush"
                                        Subtitle="Child of ScrollViewer content" />
                                </Border>

                                <Border
                                    x:Name="ScrollContainedSelectedEffectCard"
                                    Grid.Column="2"
                                    BorderBrush="#E8FFFFFF"
                                    BorderThickness="1">
                                    <local:EffectCardLabel
                                        x:Name="ScrollContainedSelectedEffectLabel"
                                        Title="GaussianBlurEffect"
                                        Subtitle="Child of ScrollViewer content" />
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Height="500" Background="Transparent">
                            <StackPanel
                                Margin="12"
                                VerticalAlignment="Top"
                                Spacing="12">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="More scrolling content" />
                                <Button Content="Button after effect panel" />
                                <ToggleSwitch Header="Another scrolling control" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="32"
                                    Text="SCROLL CONTENT 66 77 88 99" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Margin="12"
                    Padding="8,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#D9161616">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="For the closest DManip path, also test with mouse wheel / touchpad." />
                </Border>
            </Grid>

            <!-- Scenario 5: mirrors Snap.Hutao's MainView -> NavigationView -> Frame ->
                 page ScrollViewer hierarchy and reuses the same LiquidGlassBrush resources. -->
            <local:HutaoHierarchyReproControl
                x:Name="HutaoHierarchyRepro"
                Visibility="Collapsed" />

            <local:TitleBarSingleGlassReproControl
                x:Name="TitleBarSingleGlassRepro"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
