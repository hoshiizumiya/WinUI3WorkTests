<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3csWorkTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:WinUI3csWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinUI3csWorkTest"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TitleBar Height="36">
            <Grid>
                <TextBlock Text="WinUI3csWorkTest" />
            </Grid>
        </TitleBar>
        <StackPanel Grid.Row="1">
            <ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind AppThemeService}">
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
                <ComboBoxItem Content="Default" Tag="Default" />
            </ComboBox>

            <ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind AppThemeService}">
                <ComboBoxItem Content="None" Tag="None" />
                <ComboBoxItem Content="Mica" Tag="Mica" />
                <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                <ComboBoxItem Content="Transparent" Tag="Transparent" />
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="LayoutRoot" Grid.Row="2">
            <StackPanel
                Padding="12"
                BorderBrush="Black"
                BorderThickness="4">
                <TextBlock Text="Indeterminate Progress Bar" />
                <ProgressBar Margin="0,12" IsIndeterminate="True" />
            </StackPanel>
            <StackPanel
                Padding="12"
                BorderBrush="Black"
                BorderThickness="4">
                <TextBlock Text="Value-Based Progress Bar" />
                <ProgressBar
                    x:Name="progressBar1"
                    Margin="0,12"
                    Maximum="200"
                    Style="{StaticResource DefaultProgressBarStyle}"
                    Value="0" />
                <RepeatButton Click="RepeatButton_Click" Content="Press and hold" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="FontTest" Grid.Row="3">
            <TextBlock Text="Indeterminate Progress Bar" />
        </StackPanel>
    </Grid>
</Window>
