<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3csWorkTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:WinUI3csWorkTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinUI3csWorkTest"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <TitleBar Height="36">
            <Grid>
                <TextBlock Text="WinUI3csWorkTest" />
            </Grid>
        </TitleBar>
        <StackPanel>
            <ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind AppThemeService}">
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
                <ComboBoxItem Content="Default" Tag="Default" />
            </ComboBox>

            <ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind AppThemeService}">
                <ComboBoxItem Content="None" Tag="None" />
                <ComboBoxItem Content="Mica" Tag="Mica" />
                <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                <ComboBoxItem Content="Transparent" Tag="Transparent" />
            </ComboBox>
        </StackPanel>

    </Grid>
</Window>
